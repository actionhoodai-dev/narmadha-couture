rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ========================================
    // PUBLIC COLLECTIONS (User-facing)
    // ========================================
    
    // Orders - Users can create, Admin can read
    match /orders/{orderId} {
      // Anyone can create an order (public order form)
      allow create: if true;
      
      // Only authenticated users (admin) can read orders
      allow read: if isAuthenticated();
      
      // Only authenticated users can update/delete
      allow update, delete: if isAuthenticated();
    }
    
    // Inquiries - Users can create, Admin can read
    match /inquiries/{inquiryId} {
      // Anyone can create an inquiry (public contact form)
      allow create: if true;
      
      // Only authenticated users (admin) can read inquiries
      allow read: if isAuthenticated();
      
      // Only authenticated users can update/delete
      allow update, delete: if isAuthenticated();
    }
    
    // Garment Templates - Public read, Admin only write
    match /garment_templates/{templateId} {
      // Anyone can read garment templates (for user order form)
      allow read: if true;
      
      // Only authenticated users (admin) can create/update/delete
      allow create, update, delete: if isAuthenticated();
    }
    
    // ========================================
    // FUTURE COLLECTIONS (Placeholder)
    // ========================================
    
    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
